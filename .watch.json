{
  "install": {
    "include": [
      "^package\\.json$",
      "^\\.env$"
    ]
  },
  "restart": {
    "exclude": [
      "^public/",
      "^database\\.sqlite",
      "\\.sqlite$",
      "\\.sqlite-journal$"
    ],
    "include": [
      "\\.js$",
      "\\.json$"
    ]
  },
  "throttle": 2000
}
